<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/ivGoalBackButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="?attr/homeAsUpIndicator"
                android:contentDescription="Navigate Back"
                app:tint="@color/tiertiry"
                android:layout_marginEnd="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tvGoalScreenTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add A New Goal"
                android:textColor="@color/tiertiry"
                android:textSize="22sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Goal Title"
            android:layout_marginBottom="16dp"
            android:textColorHint="@color/tiertiry"
            app:hintTextColor="#BB86FC"
            app:boxBackgroundColor="#1AFFFFFF"
            app:boxStrokeColor="#BB86FC"
            app:boxStrokeWidth="1dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tiertiry"
                android:inputType="textCapSentences"/>
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbHasGoalTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Target"
            android:textColor="@color/Secondary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/llTargetMetricContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            android:baselineAligned="false">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Target Value"
                android:layout_marginEnd="8dp"
                android:textColorHint="@color/tiertiry"
                app:hintTextColor="#BB86FC"
                app:boxBackgroundColor="#1AFFFFFF"
                app:boxStrokeColor="#BB86FC"
                app:boxStrokeWidth="1dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGoalTargetValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tiertiry"
                    android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Unit"
                android:layout_marginStart="8dp"
                android:textColorHint="@color/tiertiry"
                app:hintTextColor="#BB86FC"
                app:boxBackgroundColor="#1AFFFFFF"
                app:boxStrokeColor="#BB86FC"
                app:boxStrokeWidth="1dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:id="@+id/spGoalTargetUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tiertiry"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:baselineAligned="false">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Category"
                android:layout_marginEnd="8dp"
                android:textColorHint="@color/tiertiry"
                app:hintTextColor="#BB86FC"
                app:boxBackgroundColor="#1AFFFFFF"
                app:boxStrokeColor="#BB86FC"
                app:boxStrokeWidth="1dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:id="@+id/etGoalCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tiertiry"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Priority"
                android:layout_marginStart="8dp"
                android:textColorHint="@color/tiertiry"
                app:hintTextColor="#BB86FC"
                app:boxBackgroundColor="#1AFFFFFF"
                app:boxStrokeColor="#BB86FC"
                app:boxStrokeWidth="1dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
                <AutoCompleteTextView
                    android:id="@+id/etGoalPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tiertiry"
                    android:inputType="none"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Objective Start Date"
            android:layout_marginBottom="16dp"
            android:textColorHint="@color/tiertiry"
            app:hintTextColor="#BB86FC"
            app:boxBackgroundColor="#1AFFFFFF"
            app:boxStrokeColor="#BB86FC"
            app:boxStrokeWidth="1dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:textColor="@color/tiertiry"/>
        </com.google.android.material.textfield.TextInputLayout>

        <CheckBox
            android:id="@+id/cbHasGoalTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link to Habit"
            android:textColor="@color/Secondary"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/llDateBoundaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <CheckBox
                android:id="@+id/cbHasEndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set End Date"
                android:textColor="@color/Secondary"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilGoalEndDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Objective End Date"
                android:layout_marginBottom="16dp"
                android:textColorHint="@color/tiertiry"
                app:hintTextColor="#BB86FC"
                app:boxBackgroundColor="#1AFFFFFF"
                app:boxStrokeColor="#BB86FC"
                app:boxStrokeWidth="1dp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etGoalEndDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:clickable="true"
                    android:textColor="@color/tiertiry"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llGoalHabitContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connect To Habit:"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:layout_marginBottom="6dp"/>

            <Spinner
                android:id="@+id/spLinkHabit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:paddingHorizontal="12dp"
                android:background="@drawable/spinner_outlined_bg"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Goal Description Notes"
            android:textColorHint="@color/tiertiry"
            app:hintTextColor="#BB86FC"
            app:boxBackgroundColor="#1AFFFFFF"
            app:boxStrokeColor="#BB86FC"
            app:boxStrokeWidth="1dp"
            android:layout_marginBottom="20dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGoalNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tiertiry"
                android:inputType="textMultiLine"
                android:minLines="2"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Linked Tasks :"
            android:textColor="@color/Secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type linked task"
                android:textColorHint="@color/tiertiry"
                app:hintTextColor="#BB86FC"
                app:boxBackgroundColor="#1AFFFFFF"
                app:boxStrokeColor="#BB86FC"
                app:boxStrokeWidth="1dp"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSubtaskInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/tiertiry"
                    android:inputType="textCapSentences"/>
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btnAppendSubtask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Add"
                android:backgroundTint="#BB86FC" />
        </LinearLayout>

        <TableLayout
            android:id="@+id/tlSubtasksContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:stretchColumns="0" />

        <Button
            android:id="@+id/btnSaveGoalBlueprint"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Save Goal "
            android:textColor="@android:color/white"
            android:backgroundTint="#BB86FC"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>