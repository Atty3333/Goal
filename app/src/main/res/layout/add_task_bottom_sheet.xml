<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/Primary"
    android:padding="20dp"
    app:behavior_peekHeight="450dp">

    <View
        android:id="@+id/taskSheetHandle"
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:background="#44FFFFFF"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTaskSheetHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="New Task"
        android:textColor="@color/tiertiry"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/taskSheetHandle"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="What needs to be done?"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="#BB86FC"
        app:boxBackgroundColor="#1AFFFFFF"
        app:boxStrokeColor="#BB86FC"
        app:boxStrokeWidth="1dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:layout_constraintTop_toBottomOf="@id/tvTaskSheetHeader">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tiertiry"
            android:textSize="15sp"
            android:inputType="textCapSentences"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTaskCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:hint="Category Badge"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="#BB86FC"
        app:boxBackgroundColor="#1AFFFFFF"
        app:boxStrokeColor="#BB86FC"
        app:boxStrokeWidth="1dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:layout_constraintTop_toBottomOf="@id/tilTaskTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tilTaskPriority">
        <AutoCompleteTextView
            android:id="@+id/spTaskCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tiertiry"
            android:textSize="14sp"
            android:paddingVertical="14dp"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTaskPriority"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:hint="Priority Status"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="#BB86FC"
        app:boxBackgroundColor="#1AFFFFFF"
        app:boxStrokeColor="#BB86FC"
        app:boxStrokeWidth="1dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:layout_constraintTop_toTopOf="@id/tilTaskCategory"
        app:layout_constraintStart_toEndOf="@id/tilTaskCategory"
        app:layout_constraintEnd_toEndOf="parent">
        <AutoCompleteTextView
            android:id="@+id/spTaskPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tiertiry"
            android:textSize="14sp"
            android:paddingVertical="14dp"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTaskDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Task Execution Date"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="#BB86FC"
        app:boxBackgroundColor="#1AFFFFFF"
        app:boxStrokeColor="#BB86FC"
        app:boxStrokeWidth="1dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:layout_constraintTop_toBottomOf="@id/tilTaskCategory">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:clickable="true"
            android:textColor="@color/tiertiry"
            android:textSize="15sp"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTaskNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Notes / Context Details (Optional)"
        android:textColorHint="@color/text_secondary"
        app:hintTextColor="#BB86FC"
        app:boxBackgroundColor="#1AFFFFFF"
        app:boxStrokeColor="#BB86FC"
        app:boxStrokeWidth="1dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:layout_constraintTop_toBottomOf="@id/tilTaskDate">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTaskNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/tiertiry"
            android:textSize="15sp"
            android:gravity="top"
            android:minLines="2"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"/>
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/cbLinkTaskToGoal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Link Task to a Goal "
        android:textColor="@color/Secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tilTaskNotes"
        app:layout_constraintStart_toStartOf="parent"/>

    <Spinner
        android:id="@+id/spTaskGoalLink"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#1AFFFFFF"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cbLinkTaskToGoal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="Save Task"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:paddingVertical="12dp"
        app:backgroundTint="#BB86FC"
        app:layout_constraintTop_toBottomOf="@id/spTaskGoalLink"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>